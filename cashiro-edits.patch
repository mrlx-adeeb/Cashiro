diff --git a/.github/workflows/build-debug-apk.yml b/.github/workflows/build-debug-apk.yml
new file mode 100644
index 0000000..e4f34e6
--- /dev/null
+++ b/.github/workflows/build-debug-apk.yml
@@ -0,0 +1,75 @@
+# Build a debug APK of this edited Cashiro copy in the cloud.
+#
+# Why this exists: the local Gradle build in this sandbox fails before it
+# starts ("Could not receive a message from the daemon" — see build.log).
+# The daemon cannot run here, and there is no cached Gradle dependency
+# set, so a local build would have to download everything first.
+# GitHub Actions runs the same Gradle build on ubuntu-latest, where the
+# daemon works. A *debug* APK needs no keystore or secrets — Gradle signs
+# it automatically — so this workflow needs no setup beyond pushing the
+# code to a repo and pressing Run.
+#
+# How to use it:
+#   1. Put this working copy into a GitHub repo (fork or new repo).
+#   2. On GitHub: Actions tab -> "Build debug APK" -> Run workflow.
+#   3. When it finishes green, download "cashiro-debug-apk" from the
+#      run's Artifacts section and install the APK on the phone.
+#      (A debug APK installs fine alongside nothing else; uninstall any
+#      Play Store / original Cashiro first if the install complains about
+#      a conflicting signature — it is signed with a different key.)
+#
+# The workflow also strips the sandbox-only proxy lines
+# (hatch-egress-proxy) from gradle.properties before building, because
+# that proxy does not exist outside this sandbox and would break
+# dependency downloads on the runner.
+
+name: Build debug APK
+
+on:
+  workflow_dispatch:
+
+jobs:
+  build-debug-apk:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v4
+
+      - name: Set up JDK 17
+        uses: actions/setup-java@v4
+        with:
+          java-version: '17'
+          distribution: 'temurin'
+
+      - name: Setup Android SDK
+        uses: android-actions/setup-android@v3
+
+      - name: Cache Gradle packages
+        uses: actions/cache@v4
+        with:
+          path: |
+            ~/.gradle/caches
+            ~/.gradle/wrapper
+          key: ${{ runner.os }}-gradle-${{ hashFiles('**/*.gradle*', '**/gradle-wrapper.properties') }}
+          restore-keys: |
+            ${{ runner.os }}-gradle-
+
+      - name: Grant execute permission for gradlew
+        run: chmod +x gradlew
+
+      - name: Remove sandbox-only proxy settings
+        run: sed -i '/hatch-egress-proxy/d' gradle.properties
+
+      - name: Build debug APK
+        env:
+          GRADLE_OPTS: -Dorg.gradle.jvmargs="-Xmx6G"
+        run: ./gradlew assembleStandardDebug --no-daemon
+
+      - name: Upload debug APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: cashiro-debug-apk
+          path: app/build/outputs/apk/standard/debug/*.apk
+          retention-days: 7
diff --git a/BUILD_ON_PHONE.txt b/BUILD_ON_PHONE.txt
new file mode 100644
index 0000000..115d529
--- /dev/null
+++ b/BUILD_ON_PHONE.txt
@@ -0,0 +1,39 @@
+BUILD CASHIRO ON YOUR PHONE (no PC needed)
+==========================================
+App to use: AndroidIDE (free) - it builds real Android apps on the phone itself.
+
+1. Install AndroidIDE
+   - Open: https://github.com/AndroidIDEOfficial/AndroidIDE/releases
+   - Download the latest .apk (arm64) and install it (allow "install unknown apps" if asked).
+
+2. First open
+   - AndroidIDE will ask to install its SDK/JDK - allow it, keep the phone on Wi-Fi.
+     This is a big one-time download. Let it finish fully.
+
+3. Get the project on the phone
+   - Download Cashiro-phone-build.zip (sent by Muse in chat) to Downloads.
+   - Extract it (Files app > zip > Extract). You get a folder: Cashiro-phone
+
+4. Open the project
+   - AndroidIDE > Open Project > choose the Cashiro-phone folder.
+   - Wait for Gradle sync to finish (first time downloads many libraries - Wi-Fi + patience).
+
+5. Build a DEBUG APK first (simplest - no keystore setup)
+   - Menu / Run: Gradle tasks > app > assembleStandardDebug
+   - Or use the Run/build button and pick the "standardDebug" variant if asked.
+   - First build can take 20-45 min on a phone. Keep the screen on / plug in the charger.
+   - Close other apps before building - this is a heavy project.
+
+6. Install your APK
+   - When the build succeeds, the APK is at:
+     Cashiro-phone/app/build/outputs/apk/standard/debug/
+   - Tap the .apk file and install it.
+   - NOTE: debug builds are signed with a test key, so if the Play Store / GitHub
+     version of Cashiro is already installed, uninstall that first (export a backup
+     of your data inside Cashiro before uninstalling!).
+
+Notes
+- This copy already has: SMS tracking removed, delete-expense balance bug fixed,
+  category deletion unlocked, Cashiro AI removed, R8 optimisation set for release.
+- local.properties was intentionally removed - AndroidIDE creates its own.
+- If sync/build fails, screenshot the red error in AndroidIDE and send it to Muse.
